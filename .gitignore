# Secrets
.env

# OpenHAB - ignore userdata except jsondb
openhab/userdata/*
!openhab/userdata/jsondb/
openhab/userdata/jsondb/*
!openhab/userdata/jsondb/uicomponents_ui_page.json
!openhab/userdata/jsondb/automation_rules.json

homegear/logs/
backups/
*.tar.gz
homegear-backup.tar.gz

# Homegear db
homegear/data/*

# Homegear - ignore db
homegear/admin-ui/
homegear/node-blue/
homegear/ui/
homegear/web-ssh/
homegear/www/
homegear/modules/
homegear/scripts/
homegear/defaultRoles.json
homegear/db.sql*
homegear/config/devices/*/
mosquitto/log/*.log
mosquitto/data/

# Z-Wave JS UI - runtime data (generated by container)
zwavejs/config/*.jsonl
zwavejs/config/*.jsonl.lock/
zwavejs/config/.session-secret
zwavejs/config/.config-db/
zwavejs/config/logs/
zwavejs/config/sessions/
zwavejs/config/snippets/
zwavejs/config/settings.json
zwavejs/config/users.json
zwavejs/config/nodes.json

# enoceanmqtt - runtime db
enoceanmqtt/config/devices.db
enoceanmqtt/config/enoceanmqtt.log

# Home Assistant - runtime data
homeassistant/config/.HA_VERSION
homeassistant/config/.cache/
homeassistant/config/.ha_run.lock
homeassistant/config/.storage/
homeassistant/config/blueprints/
homeassistant/config/home-assistant.log
homeassistant/config/home-assistant.log.*
homeassistant/config/home-assistant_v2.db*

# Python artifacts
__pycache__/
*.pyc
